{
  "name": "AudioVault - Web Music Player",
  "short_name": "AudioVault",
  "description": "High-performance web music player streaming your audio collection directly from GitHub Pages",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#07090e",
  "theme_color": "#10b981",
  "orientation": "any",
  "categories": [
    "music",
    "entertainment",
    "audio"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
